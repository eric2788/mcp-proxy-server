{
  "name": "mcp-proxy-server",
  "version": "0.1.0",
  "author": "Adam Wattis",
  "license": "MIT",
  "description": "An MCP proxy server that aggregates and serves multiple MCP resource servers through a single interface",
  "private": true,
  "type": "module",
  "bin": {
    "mcp-proxy-server": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "nodemon --watch 'src/**' --ext 'ts,json' --ignore src/**/*.spec.ts --exec tsx src/index.ts",
    "dev:sse": "nodemon --watch 'src/**' --ext 'ts,json' --ignore src/**/*.spec.ts --exec tsx src/sse.ts",
    "dev:app": "next dev",
    "build": "tsc -p tsconfig.build.json",
    "build:app": "next build",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "start": "node build/index.js",
    "start:sse": "node build/sse.js",
    "start:app": "next start"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.13.0",
    "@emotion/react": "^11.14.0",
    "@modelcontextprotocol/sdk": "0.6.0",
    "@types/cors": "^2.8.17",
    "cors": "^2.8.5",
    "eventsource": "^3.0.2",
    "express": "^4.21.1",
    "next": "^15.2.3",
    "next-themes": "^0.4.6",
    "proper-lockfile": "^4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.24",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.12",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3"
  }
}
